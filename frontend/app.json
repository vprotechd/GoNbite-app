{
  "expo": {
    "name": "Snaxx",
    "slug": "snaxx",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/icon.png",

    "scheme": "snaxx",

    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/expo.icon"
    },

    "android": {
      "package": "com.snaxx.app",

      "adaptiveIcon": {
        "backgroundColor": "#EF2C1E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },

      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EF2C1E",
          "image": "./assets/images/Logo.png",
          "imageWidth": 150
        }
      ],

      "expo-web-browser",

      "expo-barcode-scanner",

      "expo-audio",

      "expo-image",

      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Snaxx to use your microphone for voice ordering.",
          "speechRecognitionPermission": "Allow Snaxx to recognize your voice orders."
        }
      ],

      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyB_07WVBVy5bVdb9H7R2IbDnLnRBzZnklA"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}